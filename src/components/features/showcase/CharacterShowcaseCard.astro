---
import type { CharacterShowcaseItem } from "../../../data/characters";
import { url } from "../../../utils/url-utils";

interface Props {
	character: CharacterShowcaseItem;
	index?: number;
}

const { character, index = 0 } = Astro.props;
---

<a
	href={url(character.href)}
	data-no-swup=""
	data-work={character.work}
	style={`--char-accent: ${character.accentColor}; --char-soft: ${character.accentSoft}; --stagger: ${index * 0.06}s;`}
	class="showcase-card group relative flex flex-col overflow-hidden rounded-2xl border border-[var(--line-divider)] bg-[var(--btn-regular-bg)]/40 dark:bg-white/[0.03] transition-all duration-300 hover:-translate-y-1"
>
	<!-- 立绘完整展示舱：固定宽高比 + object-contain，确保头顶呆毛与左右袖口 100% 完整无裁切 -->
	<div
		class="relative w-full aspect-[1/1.05] px-4 pt-5 pb-0 flex items-end justify-center overflow-hidden"
	>
		<!-- 柔和角色印象色底光 -->
		<div class="showcase-aura pointer-events-none" aria-hidden="true"></div>

		<img
			src={character.portrait}
			alt={character.name}
			loading="lazy"
			decoding="async"
			class="relative z-10 w-full h-full object-contain object-bottom pointer-events-none transition-transform duration-500 ease-out group-hover:scale-[1.03]"
		/>
	</div>

	<!-- 底部铭牌：仅保留角色名字 -->
	<div
		class="relative z-10 px-5 py-3.5 border-t border-[var(--line-divider)] bg-[var(--card-bg)] flex items-baseline justify-between gap-2"
	>
		<h2
			class="text-lg font-bold text-black/85 dark:text-white/85 tracking-wider transition-colors duration-300 group-hover:text-[var(--char-accent)]"
		>
			{character.name}
		</h2>
		<span
			class="text-xs italic font-medium text-black/40 dark:text-white/40 tracking-widest"
		>
			{character.romanName}
		</span>
	</div>
</a>

<style>
	.showcase-card {
		animation: showcaseFadeUp 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
		animation-delay: var(--stagger, 0s);
		opacity: 0;
	}

	.showcase-card:hover {
		border-color: color-mix(
			in srgb,
			var(--char-accent) 45%,
			var(--line-divider)
		);
		box-shadow: 0 14px 32px -16px var(--char-soft);
	}

	.showcase-card.filtered-out {
		display: none;
	}

	.showcase-aura {
		position: absolute;
		inset: 12% 10% -10% 10%;
		border-radius: 9999px;
		background: radial-gradient(
			circle,
			var(--char-soft) 0%,
			transparent 70%
		);
		filter: blur(22px);
		opacity: 0.85;
		transition:
			opacity 0.4s ease,
			transform 0.4s ease;
	}

	.showcase-card:hover .showcase-aura {
		opacity: 1;
		transform: scale(1.06);
	}

	@keyframes showcaseFadeUp {
		from {
			opacity: 0;
			transform: translateY(16px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
</style>
